# Copy to .env and fill in. Never commit .env. Every variable is optional for a first
# local run: without LiveKit/Gemini/Google/SMTP keys the dashboard, API, bookings and
# tests still work (calendar = local, emails = skipped, summaries = rule-based).

# --- LiveKit Cloud (Build plan, free, no card): https://cloud.livekit.io -> Settings -> Keys
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxx
LIVEKIT_API_SECRET=change-me
LIVEKIT_AGENT_NAME=luma-receptionist

# --- Google Gemini (free tier): https://aistudio.google.com/apikey
# Free-tier data may be used by Google: only synthetic/sample data in development.
GEMINI_API_KEY=
# Gemini Live native-audio model used for speech-to-speech
VOICE_MODEL=gemini-3.1-flash-live-preview
# Prebuilt voice (Aoede, Puck, Charon, Kore, Fenrir, Leda, Orus, Zephyr, ...)
VOICE_NAME=Aoede
# Text model for post-call summaries and the eval judge
LLM_MODEL=gemini-3.8-flash
# Fallbacks tried in order when the primary model is busy (comma-separated)
LLM_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.1-flash-lite

# --- Database
DATABASE_URL=postgresql+psycopg://receptionist:receptionist@localhost:55432/receptionist

# --- Google Calendar: create a service account (console.cloud.google.com -> IAM ->
# Service accounts), enable the Calendar API, download its JSON key, and share the
# business calendar with the service account's email ("Make changes to events").
# Paste the JSON on one line. Leave empty to use the built-in local calendar.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CALENDAR_ID=

# --- Email (any SMTP; Gmail needs an app password: myaccount.google.com/apppasswords)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Luma Hair Studio <no-reply@example.com>
# Where messages and handoff alerts go (the demo inbox in demo mode)
STAFF_NOTIFY_EMAIL=

# --- Agent <-> API service token: a long random string, e.g. `openssl rand -hex 32`
AGENT_SERVICE_TOKEN=change-me-to-a-long-random-string

# --- Call handling
TRANSFER_ENABLED=false          # true = SIP transfer to HANDOFF_NUMBER on phone calls
HANDOFF_NUMBER=                 # E.164, e.g. +15550100199
MAX_CALL_MINUTES=10
BOOKING_WINDOW_DAYS=30
TRANSCRIPT_RETENTION_DAYS=30

# --- Demo mode (public demo): 3-minute calls, daily cap, nightly reset, no deletes
DEMO_MODE=false
DEMO_DAILY_CALLS=20

# --- Web / security
SESSION_SECRET=change-me
COOKIE_SECURE=false             # true in production (HTTPS)
ALLOWED_ORIGINS=http://localhost:3010
TRUSTED_PROXY_HOPS=1            # proxies appending X-Forwarded-For (2 for Vercel -> Render)
NEXT_PUBLIC_API_URL=http://localhost:8010
WORKER_MODE=embedded            # embedded (free demo host) | separate (production)

# --- Optional error tracking (Sentry free tier). Off unless set.
SENTRY_DSN=
